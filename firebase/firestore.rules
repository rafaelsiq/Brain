rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberDocId(groupId) {
      return groupId + '_' + request.auth.uid;
    }

    function groupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(memberDocId(groupId)));
    }

    function groupAdmin(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(memberDocId(groupId))).data.role == 'admin';
    }

    function groupCreator(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function isGroupCreatorMember() {
      return exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.createdBy
          == resource.data.userId;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if isSelf(userId);
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if groupAdmin(groupId);
      allow delete: if groupCreator(groupId);
    }

    match /members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && memberId == request.resource.data.groupId + '_' + request.auth.uid;

      // Self may leave (delete own membership) unless they are the group creator.
      // Admins may remove others, but never the creator.
      allow delete: if signedIn() && !isGroupCreatorMember() && (
        resource.data.userId == request.auth.uid
        || groupAdmin(resource.data.groupId)
      );

      // Self may update own color; admins may update others' role/color,
      // but never change the creator's role.
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.groupId == resource.data.groupId
        )
        || (
          groupAdmin(resource.data.groupId)
          && !isGroupCreatorMember()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.groupId == resource.data.groupId
        )
        || (
          groupAdmin(resource.data.groupId)
          && isGroupCreatorMember()
          && request.resource.data.role == resource.data.role
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.groupId == resource.data.groupId
        )
      );
    }

    match /songs/{songId} {
      allow read: if signedIn();
      allow create: if signedIn() && groupMember(request.resource.data.groupId);
      allow update, delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || groupAdmin(resource.data.groupId)
      );
    }

    match /participants/{id} {
      allow read, write: if signedIn();
    }

    match /stanzas/{id} {
      allow read, write: if signedIn();
    }

    match /slots/{id} {
      allow read, write: if signedIn();
    }

    match /proposals/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /votes/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /sessions/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /audioTakes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
